# 文昌智脑本地密钥配置示例。复制为 local-secrets.properties 后填写真实密钥。
wenchang.ai.default.provider=deepseek
wenchang.ai.default.base-url=https://api.deepseek.com
wenchang.ai.default.api-key=
wenchang.ai.default.model=deepseek-chat
wenchang.ai.default.thinking-enabled=false

# 标准联网搜索。至少填写一个；auto 会按顺序故障转移。
wenchang.web-search.provider=auto
wenchang.web-search.tavily-api-key=
wenchang.web-search.brave-api-key=
wenchang.web-search.fallback-order=tavily,brave
wenchang.web-search.allow-html-fallback=false
